# cp .env.example .env
# Hepsi boş bırakılabilir, compose yerelde çalışacak varsayılanlarla kalkar.

POSTGRES_PASSWORD=pati
JWT_SECRET_KEY=

# Chatbot, boşsa anahtar kelimeye göre hazır cevap döner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Mail: Brevo tanımlıysa o kullanılır, yoksa Gmail SMTP
BREVO_API_KEY=
MAIL_SENDER=
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

ALLOWED_ORIGINS=*
EXPO_PUBLIC_BACKEND_URL=http://localhost:8000

# Host portları
DB_PORT=5432
BACKEND_PORT=8000
FRONTEND_PORT=8081
